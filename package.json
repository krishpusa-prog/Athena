{
  "name": "athena",
  "version": "0.1.0",
  "description": "Athena - Desktop proctoring and exam portal",
  "author": "Your Name",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.athena.exam",
    "productName": "Athena",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" }
  }
}